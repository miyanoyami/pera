---
import coverImage from '../assets/images/miyanoyami/cover2.webp';
import nameLogo from '../assets/images/miyanoyami/name_logo_color.png';
import mainImage from '../assets/images/miyanoyami/main.png';
import mainImage2 from '../assets/images/miyanoyami/main2.png';
import sonovLogo from '../assets/images/miyanoyami/sonov_logo.png';
import sonov2Logo from '../assets/images/miyanoyami/sonov2_logo.png';
import utableLogo from '../assets/images/miyanoyami/utable_logo.svg';
import oshiyellLogo from '../assets/images/miyanoyami/oshiyell_logo.png';

/* # 設計
 * ## 概要
 * VTuber 宮乃やみの公式サイト。
 * 実装には astro, CSSフレームワークとして tailwind を採用する。
 * レスポンシブデザインでスマホ・PCどちらでも表示可能。
 *
 * ## デザイン
 * 白（生成り）× 墨 × 金。差し色の金は最小限に使う。
 * グラデーションは使わない。角は丸めず、細い罫線と余白で区切る。
 * 見出しは英字セリフ（Cormorant Garamond）＋明朝（Shippori Mincho）、本文は Noto Sans JP。
 * 背景アニメーション・ローディング画面は持たない。
 * 縦スクロールは残しつつ、情報は列挙せずスライド・タブ・横スクロールでコンパクトに収める。
 *
 * ## ページ構成
 * ヘッダー画像（cover2.webp）
 * → PROFILE（立ち絵＋カードをスライドで切り替え：BASIC / CAREER / SKILLS / FAVORITE / CREATORS）
 * → HISTORY（横スクロールの年表。年ボタンでジャンプ、初期表示は最新）
 * → WORKS（カルーセル）
 * → GEAR（配信／開発のタブ切り替え）
 * → フッター
 * 各セクションの内容は下記のデータ定義を編集する。
 */

const links = [
  { label: 'YouTube', href: 'https://www.youtube.com/@miyanoyami' },
  { label: 'X', href: 'https://x.com/miyanoyami83' },
  { label: 'GitHub', href: 'https://github.com/miyanoyami' },
  { label: 'Blog', href: '/pera/blog', internal: true },
];

const profileCards = [
  {
    key: 'BASIC',
    items: [
      { label: '名前', value: '宮乃やみ（みやのやみ）' },
      { label: '英名', value: 'miyanoyami' },
      { label: '出身地', value: '北海道' },
      { label: '誕生日', value: '7月12日' },
      { label: '言語', value: '日本語・英語' },
      { label: '属性', value: '和装丸眼鏡VTuber' },
    ],
  },
  {
    key: 'CAREER',
    items: [
      { label: '職業', value: 'Webエンジニア' },
      { label: '専門領域', value: '大規模バックエンド・金融' },
      { label: '資格', value: '情報処理技術者試験12冠' },
      { label: '創作活動', value: 'VTuber向けWebサイトを複数開発・運営' },
    ],
  },
  { key: 'SKILLS' },
  {
    key: 'FAVORITE',
    items: [
      { label: '好きなお酒', value: 'クラフトビール・ウイスキー' },
    ],
  },
  { key: 'CREATORS' },
];

const creators = [
  { role: 'キャラクターデザイン', name: 'カロク', handle: 'Schwarz_jihua' },
  { role: 'イラスト・モデリング', name: '黒山シープ', handle: 'DYNAMIC_MAKKY' },
  { role: 'カバーイラスト', name: '衿崎', handle: 'erisaki_coda' },
];

const mainLanguages = ['Go', 'Java', 'Kotlin'];
const otherLanguages = ['PHP', 'Ruby', 'Scala', 'Scheme', 'JavaScript', 'TypeScript', 'Python'];

const gear = [
  {
    id: 'streaming',
    title: '配信機材',
    items: [
      { label: 'CPU', value: 'Intel Core i7-13700KF' },
      { label: 'GPU', value: 'NVIDIA GeForce RTX 3070' },
      { label: 'メモリ', value: '64GB' },
      { label: 'ストレージ', value: 'SSD 2TB' },
      { label: 'マイク', value: 'audio-technica AT4040' },
      { label: 'オーディオI/F', value: 'Steinberg UR44C' },
    ],
  },
  {
    id: 'development',
    title: '開発機材',
    items: [
      { label: 'モデル', value: 'MacBook Air M4' },
      { label: 'メモリ', value: '24GB ユニファイドメモリ' },
      { label: 'ストレージ', value: 'SSD 256GB' },
    ],
  },
];

const works = [
  { name: 'そのぶい', desc: 'VTuberおすすめサイト', href: 'https://miyanoyami.github.io/sonorv/', logo: sonovLogo },
  { name: 'うたぶる', desc: '歌枠支援ツール', href: 'https://utable.pages.dev/', logo: utableLogo },
  { name: 'おしえーる', desc: '推しが応援してくれるポモドーロタイマー', href: 'https://miyanoyami.github.io/vtimer/', logo: oshiyellLogo },
  { name: 'そのぶいつー', desc: '癖でタグ検索しまくれるVTuberのWebサイト集', href: 'https://sonov2.vtube.work/', logo: sonov2Logo },
];

const history = [
  { date: '2021.06', title: 'YouTube配信開始', desc: 'YouTubeにて配信を開始' },
  { date: '2022.04', title: '収益化達成', desc: 'チャンネル登録1,000人・収益化を達成' },
  { date: '2023.05', title: 'YouTube登録3,000人到達', desc: 'YouTubeチャンネル登録者数3,000人を達成' },
  { date: '2024.05', title: 'YouTube登録5,000人到達', desc: 'YouTubeチャンネル登録者数5,000人を達成' },
  { date: '2024.10', title: 'そのぶいリリース', desc: 'VTuberおすすめサイト『そのぶい』をリリース' },
  { date: '2025.05', title: 'うたぶるリリース', desc: '歌枠支援ツール『うたぶる』をリリース' },
  { date: '2025.07', title: 'YouTube登録1万人達成', desc: 'YouTubeチャンネル登録10,000人を達成' },
  { date: '2025.10', title: 'おしえーるリリース', desc: '推しが応援してくれるタイマー『おしえーる』をリリース' },
  { date: '2025.11', title: '秋葉原井戸端洋酒店にてコラボバーを開催', desc: 'YouTubeチャンネル登録10,000人を記念して秋葉原井戸端洋酒店でコラボバーイベントを開催しました' },
  { date: '2026.03', title: 'そのぶいつーリリース', desc: '癖でタグ検索しまくれるVTuberのWebサイト集『そのぶいつー』をリリース' },
  { date: '2026.11', title: 'HACK.BARにてコラボイベントを開催', desc: 'HACK.BAR 心斎橋店で一日店長を務めました' },
];
const years = [...new Set(history.map((h) => h.date.slice(0, 4)))];

const sections = [
  { id: 'profile', label: 'Profile' },
  { id: 'history', label: 'History' },
  { id: 'works', label: 'Works' },
  { id: 'gear', label: 'Gear' },
];

const arrowBtn = 'w-10 h-10 border border-ink flex items-center justify-center hover:bg-ink hover:text-paper transition-colors disabled:opacity-25 disabled:pointer-events-none';
---

<html lang="ja">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/x-icon" href="/pera/favicon.ico" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>宮乃やみ公式サイト</title>
  <meta name="description" content="和装丸眼鏡VTuber・Webエンジニア 宮乃やみの公式サイト" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho:wght@500;700&display=swap" rel="stylesheet">
  <style>
    @import "tailwindcss";

    @theme {
      --color-paper: #fbfaf7;
      --color-ink: #1d1d22;
      --color-sumi: #4a4a52;
      --color-mute: #8a8a90;
      --color-line: #e3e0d8;
      --color-gold: #a8862f;
      --color-gold-deep: #7d6220;
      --font-serif-en: 'Cormorant Garamond', serif;
      --font-mincho: 'Shippori Mincho', serif;
      --font-sans: 'Noto Sans JP', sans-serif;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 3.5rem;
    }

    body {
      margin: 0;
      background: var(--color-paper);
      color: var(--color-ink);
      font-family: var(--font-sans);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      word-break: auto-phrase;
    }

    .font-serif-en {
      font-variant-numeric: lining-nums tabular-nums;
    }

    /* 横スクロール領域：スクロールバーを隠してスナップさせる */
    .track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    .track::-webkit-scrollbar { display: none; }
    .track > * { scroll-snap-align: start; flex-shrink: 0; }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
    }
  </style>
</head>
<body>
  <!-- ナビゲーション -->
  <nav class="fixed inset-x-0 top-0 z-50 bg-paper/90 backdrop-blur-sm border-b border-line">
    <div class="max-w-6xl mx-auto h-14 px-4 md:px-8 flex items-center justify-between">
      <a href="#top" class="font-serif-en text-base md:text-lg tracking-[0.2em] md:tracking-[0.3em] text-ink whitespace-nowrap">MIYANO YAMI</a>
      <div class="flex items-center gap-6">
        <ul class="hidden md:flex items-center gap-6 font-serif-en text-sm tracking-[0.2em] text-sumi">
          {sections.map((s) => (
            <li><a href={`#${s.id}`} class="hover:text-gold-deep transition-colors">{s.label.toUpperCase()}</a></li>
          ))}
        </ul>
        <span class="hidden md:block w-px h-4 bg-line"></span>
        <ul class="flex items-center gap-4 text-ink">
          <li>
            <a href="https://www.youtube.com/@miyanoyami" target="_blank" rel="noopener" aria-label="YouTube" class="block hover:text-gold-deep transition-colors">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
          </li>
          <li>
            <a href="https://x.com/miyanoyami83" target="_blank" rel="noopener" aria-label="X" class="block hover:text-gold-deep transition-colors">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          </li>
          <li>
            <a href="https://github.com/miyanoyami" target="_blank" rel="noopener" aria-label="GitHub" class="block hover:text-gold-deep transition-colors">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            </a>
          </li>
          <li>
            <a href="/pera/blog" class="font-serif-en text-sm tracking-[0.2em] border border-ink px-3 py-1 hover:bg-ink hover:text-paper transition-colors">BLOG</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- ヘッダー画像＋名前 -->
  <header id="top" class="pt-14">
    <img src={coverImage.src} alt="宮乃やみ カバーイラスト" class="w-full h-[60vh] md:h-[calc(100vh-3.5rem)] object-cover object-[82%_center] md:object-[70%_center]">
    <div class="border-b border-line">
      <div class="max-w-6xl mx-auto px-4 md:px-8 py-6 md:py-8 flex items-center gap-5 md:gap-10">
        <img src={nameLogo.src} alt="宮乃やみ miyano yami" class="w-36 md:w-52 aspect-[16/7] object-cover shrink-0">
        <span class="hidden md:block w-px self-stretch bg-line"></span>
        <p class="font-mincho text-sm md:text-lg leading-relaxed">和装丸眼鏡VTuber。<br class="md:hidden">金融専門の<wbr>Webエンジニア。</p>
      </div>
    </div>
  </header>

  <main>
    <!-- PROFILE：立ち絵＋スライドカード -->
    <section id="profile" class="max-w-6xl mx-auto px-4 md:px-8 py-16 md:py-24">
      <div class="grid grid-cols-[minmax(0,1fr)] md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-8 md:gap-14 items-center">
        <div class="flex justify-center">
          <img id="character-image" src={mainImage.src} alt="宮乃やみ 立ち絵（タップ・ホバーで切り替え）" class="h-[300px] md:h-[560px] w-auto cursor-pointer select-none" width="1000" height="1500">
        </div>

        <div data-carousel>
          <div class="flex items-baseline justify-between mb-6">
            <h2 class="font-serif-en text-4xl md:text-5xl tracking-[0.15em]">PROFILE</h2>
            <span class="font-serif-en text-sm text-mute"><span data-current>01</span> / {String(profileCards.length).padStart(2, '0')}</span>
          </div>

          <!-- カード名のタブ（スライド位置と連動） -->
          <div class="track gap-x-4 md:gap-x-5 mb-4 font-serif-en text-xs md:text-sm tracking-[0.12em] md:tracking-[0.2em]" role="tablist">
            {profileCards.map((c, i) => (
              <button type="button" data-dot={i} role="tab" class="pb-1 border-b-2 border-transparent text-mute hover:text-ink transition-colors aria-selected:border-gold aria-selected:text-ink">{c.key}</button>
            ))}
          </div>

          <div data-track class="track border border-ink bg-white" tabindex="0" aria-label="プロフィールカード">
            {profileCards.map((c) => (
              <div class="w-full p-6 md:p-10 min-h-[340px]">
                {c.items && (
                  <dl class="space-y-4">
                    {c.items.map((p) => (
                      <div class="grid grid-cols-[6.5rem_1fr] gap-4 pb-4 border-b border-line last:border-0 last:pb-0">
                        <dt class="font-mincho text-sm text-mute">{p.label}</dt>
                        <dd>{p.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
                {c.key === 'SKILLS' && (
                  <div class="space-y-8">
                    <div>
                      <p class="font-serif-en text-xs tracking-[0.3em] text-gold-deep mb-4">MAIN</p>
                      <ul class="flex flex-wrap gap-x-8 gap-y-3">
                        {mainLanguages.map((lang) => (
                          <li class="border-l-4 border-gold pl-3 font-serif-en text-4xl font-semibold leading-none">{lang}</li>
                        ))}
                      </ul>
                    </div>
                    <div>
                      <p class="font-serif-en text-xs tracking-[0.3em] text-mute mb-3">OTHERS</p>
                      <ul class="flex flex-wrap gap-2">
                        {otherLanguages.map((lang) => (
                          <li class="border border-line px-3 py-1 text-sm text-sumi">{lang}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                )}
                {c.key === 'CREATORS' && (
                  <ul class="space-y-5">
                    {creators.map((cr) => (
                      <li class="pb-5 border-b border-line last:border-0 last:pb-0">
                        <p class="text-xs text-mute mb-1">{cr.role}</p>
                        <p class="flex items-baseline gap-3">
                          <span class="font-mincho text-lg">{cr.name}</span>
                          <a href={`https://x.com/${cr.handle}`} target="_blank" rel="noopener" class="text-xs text-gold-deep hover:underline">@{cr.handle}</a>
                        </p>
                      </li>
                    ))}
                    <li class="text-xs text-mute">※敬称略</li>
                  </ul>
                )}
              </div>
            ))}
          </div>

          <div class="flex justify-end gap-2 mt-4">
            <button type="button" data-prev class={arrowBtn} aria-label="前へ">←</button>
            <button type="button" data-next class={arrowBtn} aria-label="次へ">→</button>
          </div>
        </div>
      </div>
    </section>

    <!-- HISTORY：横スクロールの年表 -->
    <section id="history" class="bg-ink text-paper py-16 md:py-24 overflow-hidden" data-carousel data-start="end">
      <div class="max-w-6xl mx-auto px-4 md:px-8">
        <div class="flex flex-wrap items-end justify-between gap-6 mb-10">
          <h2 class="font-serif-en text-4xl md:text-5xl tracking-[0.15em]">HISTORY</h2>
          <div class="flex items-center gap-4">
            <ul class="flex flex-wrap gap-x-4 gap-y-1 font-serif-en text-lg">
              {years.map((y) => (
                <li><button type="button" data-year={y} class="text-mute hover:text-paper transition-colors data-[active]:text-gold">{y}</button></li>
              ))}
            </ul>
            <div class="hidden md:flex gap-2">
              <button type="button" data-prev class={arrowBtn.replaceAll('ink', 'paper').replace('hover:text-paper', 'hover:text-ink')} aria-label="前へ">←</button>
              <button type="button" data-next class={arrowBtn.replaceAll('ink', 'paper').replace('hover:text-paper', 'hover:text-ink')} aria-label="次へ">→</button>
            </div>
          </div>
        </div>

        <!-- 進み具合バー -->
        <div class="relative h-px bg-sumi mb-10">
          <div data-progress class="absolute left-0 top-0 h-[3px] -mt-px bg-gold w-0"></div>
        </div>

        <ol data-track class="track gap-6 md:gap-10" tabindex="0" aria-label="活動歴">
          {history.map((h) => (
            <li data-date={h.date} class="w-[78%] sm:w-[45%] md:w-[30%]">
              <p class="font-serif-en text-3xl md:text-4xl text-gold mb-3">{h.date}</p>
              <h3 class="font-mincho text-lg leading-snug mb-2">{h.title}</h3>
              <p class="text-sm text-line/80 leading-relaxed">{h.desc}</p>
            </li>
          ))}
          <li data-spacer aria-hidden="true" class="w-[calc(22%-1.5rem)] sm:hidden"></li>
        </ol>
      </div>
    </section>

    <!-- WORKS：カルーセル -->
    <section id="works" class="max-w-6xl mx-auto px-4 md:px-8 py-16 md:py-24" data-carousel>
      <div class="flex items-end justify-between gap-6 mb-10">
        <div class="flex items-baseline gap-4">
          <h2 class="font-serif-en text-4xl md:text-5xl tracking-[0.15em]">WORKS</h2>
          <span class="font-mincho text-sm text-mute">運営サイト</span>
        </div>
        <div class="flex gap-2">
          <button type="button" data-prev class={arrowBtn} aria-label="前へ">←</button>
          <button type="button" data-next class={arrowBtn} aria-label="次へ">→</button>
        </div>
      </div>

      <ul data-track class="track gap-4 md:gap-6" tabindex="0" aria-label="運営サイト">
        {works.map((w, i) => (
          <li class="w-[85%] sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]">
            <a href={w.href} target="_blank" rel="noopener" class="group flex flex-col h-full border border-line bg-white p-6 hover:border-ink transition-colors">
              <div class="flex justify-between items-start mb-6">
                <span class="font-serif-en text-sm text-gold">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-mute group-hover:text-ink group-hover:translate-x-1 transition-all" aria-hidden="true">↗</span>
              </div>
              <div class="h-20 flex items-center justify-center mb-6">
                <img src={w.logo.src} alt="" class="max-h-16 max-w-[80%] w-auto">
              </div>
              <h3 class="font-mincho text-lg mb-1">{w.name}</h3>
              <p class="text-sm text-sumi">{w.desc}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- GEAR：タブ切り替え -->
    <section id="gear" class="border-t border-line">
      <div class="max-w-6xl mx-auto px-4 md:px-8 py-16 md:py-24 grid grid-cols-[minmax(0,1fr)] md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-8 md:gap-14">
        <div>
          <div class="flex items-baseline gap-4 mb-6">
            <h2 class="font-serif-en text-4xl md:text-5xl tracking-[0.15em]">GEAR</h2>
            <span class="font-mincho text-sm text-mute">使用機材</span>
          </div>
          <div class="flex border border-ink w-fit" role="tablist" data-tabs>
            {gear.map((g, i) => (
              <button type="button" role="tab" data-tab={g.id} aria-selected={i === 0 ? 'true' : 'false'} class="px-5 py-2 font-mincho text-sm text-ink aria-selected:bg-ink aria-selected:text-paper transition-colors">{g.title}</button>
            ))}
          </div>
        </div>

        <div>
          {gear.map((g, i) => (
            <dl data-panel={g.id} role="tabpanel" hidden={i !== 0} class="border-t border-ink">
              {g.items.map((item) => (
                <div class="grid grid-cols-[7rem_1fr] md:grid-cols-[8rem_1fr] gap-4 py-3 border-b border-line text-sm">
                  <dt class="text-mute">{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-ink text-paper">
    <div class="max-w-6xl mx-auto px-4 md:px-8 py-12 flex flex-col md:flex-row gap-6 md:items-center md:justify-between">
      <p class="font-serif-en text-xl tracking-[0.3em]">MIYANO YAMI</p>
      <ul class="flex gap-6 font-serif-en text-sm tracking-[0.2em]">
        {links.map((l) => (
          <li><a href={l.href} target={l.internal ? undefined : '_blank'} rel={l.internal ? undefined : 'noopener'} class="hover:text-gold transition-colors">{l.label.toUpperCase()}</a></li>
        ))}
      </ul>
      <p class="text-xs text-mute">&copy; 宮乃やみ all rights reserved.</p>
    </div>
  </footer>

  <script define:vars={{ mainImageSrc: mainImage.src, mainImage2Src: mainImage2.src }}>
    // 立ち絵の切り替え（PC：ホバー／スマホ：タップ）
    const characterImage = document.getElementById('character-image');
    const images = [mainImageSrc, mainImage2Src];
    new Image().src = mainImage2Src;
    let current = 0;
    let lastPointer = 'mouse';
    const show = (i) => { current = i; characterImage.src = images[i]; };
    characterImage.addEventListener('pointerenter', (e) => { lastPointer = e.pointerType; if (e.pointerType === 'mouse') show(1); });
    characterImage.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') show(0); });
    characterImage.addEventListener('click', () => { if (lastPointer !== 'mouse') show((current + 1) % images.length); });

    // 横スクロール（カルーセル・年表）
    const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    document.querySelectorAll('[data-carousel]').forEach((root) => {
      const track = root.querySelector('[data-track]');
      const items = [...track.children].filter((el) => !el.hasAttribute('data-spacer'));
      const prevs = root.querySelectorAll('[data-prev]');
      const nexts = root.querySelectorAll('[data-next]');
      const dots = root.querySelectorAll('[data-dot]');
      const years = root.querySelectorAll('[data-year]');
      const counter = root.querySelector('[data-current]');
      const progress = root.querySelector('[data-progress]');

      const offsetOf = (el) => el.offsetLeft - track.offsetLeft;
      const indexNow = () => {
        let best = 0;
        items.forEach((el, i) => { if (Math.abs(offsetOf(el) - track.scrollLeft) < Math.abs(offsetOf(items[best]) - track.scrollLeft)) best = i; });
        return best;
      };
      const goTo = (i) => {
        const target = items[Math.max(0, Math.min(items.length - 1, i))];
        track.scrollTo({ left: offsetOf(target), behavior: smooth });
      };

      const update = () => {
        const max = track.scrollWidth - track.clientWidth;
        const i = track.scrollLeft >= max - 2 ? items.length - 1 : indexNow();
        prevs.forEach((b) => (b.disabled = track.scrollLeft <= 2));
        nexts.forEach((b) => (b.disabled = track.scrollLeft >= max - 2));
        dots.forEach((d, j) => d.setAttribute('aria-selected', String(j === i)));
        if (counter) counter.textContent = String(i + 1).padStart(2, '0');
        if (progress) progress.style.width = (max > 0 ? (track.scrollLeft / max) * 100 : 100) + '%';
        if (years.length) {
          const y = items[i].dataset.date.slice(0, 4);
          years.forEach((b) => b.toggleAttribute('data-active', b.dataset.year === y));
        }
      };

      prevs.forEach((b) => b.addEventListener('click', () => goTo(indexNow() - 1)));
      nexts.forEach((b) => b.addEventListener('click', () => goTo(indexNow() + 1)));
      dots.forEach((d) => d.addEventListener('click', () => goTo(Number(d.dataset.dot))));
      years.forEach((b) => b.addEventListener('click', () => goTo(items.findIndex((el) => el.dataset.date.startsWith(b.dataset.year)))));
      track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); goTo(indexNow() + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(indexNow() - 1); }
      });
      window.addEventListener('resize', update);

      if (root.dataset.start === 'end') track.scrollLeft = Math.min(offsetOf(items[items.length - 1]), track.scrollWidth);
      update();
    });

    // タブ（機材）
    document.querySelectorAll('[data-tabs]').forEach((list) => {
      const tabs = list.querySelectorAll('[data-tab]');
      tabs.forEach((tab) => tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          document.querySelector(`[data-panel="${t.dataset.tab}"]`).hidden = !on;
        });
      }));
    });
  </script>
</body>
</html>
